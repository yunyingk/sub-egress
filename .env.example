# sub-egress Environment Configuration

# Host port mapping
PORT=8000

# Exact browser origin used for passkey verification (required for passkeys)
# WEBAUTHN_ORIGIN=https://sub.example.com

# GitHub OAuth App (register callback as https://your-host/api/auth/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://your-host/api/auth/github/callback
# SECRET_KEY=generate-a-long-random-secret

# Database Connection (Optional)
# Leave commented or blank to use zero-config SQLite stored in /data/sub_egress.db
# Or uncomment to connect to your PostgreSQL instance:
# DATABASE_URL=postgresql+asyncpg://dev:password@postgres:5432/sub_egress
